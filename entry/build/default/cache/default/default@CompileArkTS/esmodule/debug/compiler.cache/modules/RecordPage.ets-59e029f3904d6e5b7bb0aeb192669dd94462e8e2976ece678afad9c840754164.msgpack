                let newY = d.y - d.speed;
                if (newY < -5)
                    newY = 105;
                updated.push({
                    id: d.id,
                    x: d.x + Math.sin(this.animOffset * 0.02 + d.id) * 0.03,
                    y: newY,
                    size: d.size,
                    opacity: d.opacity,
                    speed: d.speed
