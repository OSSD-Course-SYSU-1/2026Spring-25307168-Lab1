        for (let i = 0; i < 12; i++) {
            this.dots.push({
                id: this.dotId++,
                x: Math.random() * 100,
                y: Math.random() * 100,
                size: 2 + Math.random() * 4,
                opacity: 0.05 + Math.random() * 0.2,
