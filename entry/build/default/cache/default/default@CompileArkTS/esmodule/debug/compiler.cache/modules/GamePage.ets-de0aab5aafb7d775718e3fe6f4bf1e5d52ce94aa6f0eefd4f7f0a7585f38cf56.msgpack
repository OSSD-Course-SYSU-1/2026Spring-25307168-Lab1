    isPositionValid(x, y, radius) {
        const areaWidth = this.gameAreaWidth || (this.isSmallScreen ? 300 : 500);
        const areaHeight = this.gameAreaHeight || (this.isSmallScreen ? 400 : 600);
        // è¾¹ç•ŒéªŒè¯
        if (x < radius || x > areaWidth - radius) {
